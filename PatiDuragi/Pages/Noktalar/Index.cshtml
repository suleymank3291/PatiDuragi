@page
@model PatiDuragi.Pages.Noktalar.IndexModel
@{
    ViewData["Title"] = "Besleme Noktaları";
    var onayliSayisi = Model.Noktalar.Count(n => n.Onayli);
    var bekleyenSayisi = Model.Noktalar.Count - onayliSayisi;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Besleme Noktaları</h1>
        <p class="text-muted mb-0">@Model.Noktalar.Count nokta, @Model.Bolgeler.Count mahalleye dağılmış durumda.</p>
    </div>
    <a asp-page="Ekle" class="btn btn-success"><i class="bi bi-plus-lg"></i> Yeni Nokta</a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="ozet"><i class="bi bi-geo-alt text-primary"></i> <strong>@Model.Noktalar.Count</strong> toplam</span>
    <span class="ozet"><i class="bi bi-check-circle text-success"></i> <strong>@onayliSayisi</strong> onaylı</span>
    <span class="ozet"><i class="bi bi-hourglass-split text-warning"></i> <strong>@bekleyenSayisi</strong> onay bekliyor</span>
</div>

<div id="harita" class="harita rounded-3 border shadow-sm mb-4"></div>

@if (Model.Bolgeler.Count == 0)
{
    <div class="text-center text-muted border rounded-3 py-5">
        <i class="bi bi-map kart-ikon"></i>
        <p class="mt-2">Nokta eklemek için önce bir mahalle ekleyin.</p>
        <a asp-page="/Bolgeler/Ekle" class="btn btn-success btn-sm">Mahalle ekle</a>
    </div>
}
else
{
    <div class="row g-4">
        @* Solda mahalle menüsü: tıklanınca sayfa o mahallenin bölümüne iner *@
        <div class="col-12 col-lg-3">
            <nav class="mahalle-menu">
                <div class="text-muted small fw-semibold text-uppercase mb-2 d-none d-lg-block">Mahalleler</div>
                <div class="nav nav-pills flex-lg-column flex-nowrap overflow-auto gap-1">
                    @foreach (var bolge in Model.Bolgeler)
                    {
                        <a class="nav-link d-flex justify-content-between align-items-center gap-2 text-nowrap" href="#bolge-@bolge.Id">
                            <span>@bolge.Mahalle <span class="text-muted small">· @bolge.Ilce</span></span>
                            <span class="badge rounded-pill text-bg-light border">@bolge.Noktalar.Count</span>
                        </a>
                    }
                </div>
            </nav>
        </div>

        <div class="col-12 col-lg-9">
            @foreach (var bolge in Model.Bolgeler)
            {
                <section id="bolge-@bolge.Id" class="bolum mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-2 border-bottom pb-2 mb-3">
                        <i class="bi bi-pin-map text-danger fs-5"></i>
                        <h2 class="h5 mb-0">@bolge.Mahalle</h2>
                        <span class="text-muted">@bolge.Ilce</span>
                        <span class="badge rounded-pill text-bg-light border">@bolge.Noktalar.Count nokta</span>
                        <a asp-page="/Bolgeler/Detay" asp-route-id="@bolge.Id" class="ms-auto small text-decoration-none">Mahalleyi gör <i class="bi bi-arrow-right"></i></a>
                    </div>

                    @if (bolge.Noktalar.Count == 0)
                    {
                        <div class="text-muted small border rounded-3 p-3 d-flex align-items-center gap-2">
                            <i class="bi bi-inbox"></i> Bu mahallede henüz nokta yok.
                            <a asp-page="Ekle" asp-route-bolgeId="@bolge.Id" class="ms-auto">Nokta ekle</a>
                        </div>
                    }

                    <div class="row g-3">
                        @foreach (var nokta in bolge.Noktalar.OrderBy(n => n.Ad))
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 shadow-sm kart-hover">
                                    <div class="card-body d-flex gap-3">
                                        <partial name="_TurIkonu" model="nokta.Tur" />
                                        <div class="flex-grow-1">
                                            <h3 class="h6 mb-1">
                                                <a asp-page="Detay" asp-route-id="@nokta.Id" class="text-reset text-decoration-none">@nokta.Ad</a>
                                            </h3>
                                            <p class="text-muted small mb-2 iki-satir">@nokta.Aciklama</p>
                                            <partial name="_TurRozeti" model="nokta.Tur" />
                                            <partial name="_OnayDurumu" model="nokta.Onayli" />
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent d-flex align-items-center">
                                        <a asp-page="Detay" asp-route-id="@nokta.Id" class="small text-decoration-none">Detay <i class="bi bi-arrow-right"></i></a>
                                        <div class="ms-auto">
                                            <a asp-page="Duzenle" asp-route-id="@nokta.Id" class="btn btn-sm btn-light" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                            <a asp-page="Sil" asp-route-id="@nokta.Id" class="btn btn-sm btn-light text-danger" title="Sil"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        haritaCiz(@Json.Serialize(Model.Noktalar.Select(n => new { n.Id, n.Ad, n.Tur, n.Enlem, n.Boylam })),
                  @Json.Serialize(Model.Bolgeler.Select(b => b.Sinir)));
    </script>
}
