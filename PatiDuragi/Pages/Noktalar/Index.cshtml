@page
@model PatiDuragi.Pages.Noktalar.IndexModel
@{
    ViewData["Title"] = "Besleme Noktaları";
}

<h1 class="h2 mb-3">Besleme Noktaları <span class="badge text-bg-secondary fs-6 align-middle">@Model.Noktalar.Count</span></h1>

<partial name="_Harita" model="Model.Noktalar" />

<div class="row g-3">
    @foreach (var nokta in Model.Noktalar)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 card-title">@nokta.Ad</h2>
                    <p class="text-muted small mb-2"><i class="bi bi-map"></i> @Model.BolgeAdi(nokta.BolgeId)</p>
                    <p class="card-text">@nokta.Aciklama</p>
                    <partial name="_TurRozeti" model="nokta.Tur" />
                    <partial name="_OnayDurumu" model="nokta.Onayli" />
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-page="Detay" asp-route-id="@nokta.Id" class="btn btn-sm btn-outline-success">Detay</a>
                </div>
            </div>
        </div>
    }
</div>
