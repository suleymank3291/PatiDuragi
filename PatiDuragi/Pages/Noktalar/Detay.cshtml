@page "{id:int}"
@model PatiDuragi.Pages.Noktalar.DetayModel
@{
    ViewData["Title"] = "Nokta Detayı";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Besleme Noktaları</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SeciliNokta.Ad</li>
    </ol>
</nav>

<h1 class="h2">@Model.SeciliNokta.Ad</h1>
<p class="mb-4">
    <partial name="_TurRozeti" model="Model.SeciliNokta.Tur" />
    <partial name="_OnayDurumu" model="Model.SeciliNokta.Onayli" />
</p>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <dl class="row">
            <dt class="col-sm-4">Bölge</dt>
            <dd class="col-sm-8">
                @if (Model.NoktaninBolgesi != null)
                {
                    <a asp-page="/Bolgeler/Detay" asp-route-id="@Model.NoktaninBolgesi.Id">@Model.NoktaninBolgesi.Ad</a>
                }
            </dd>
            <dt class="col-sm-4">Açıklama</dt>
            <dd class="col-sm-8">@Model.SeciliNokta.Aciklama</dd>
            <dt class="col-sm-4">Enlem</dt>
            <dd class="col-sm-8">@Model.SeciliNokta.Enlem</dd>
            <dt class="col-sm-4">Boylam</dt>
            <dd class="col-sm-8">@Model.SeciliNokta.Boylam</dd>
        </dl>
        <a asp-page="Duzenle" asp-route-id="@Model.SeciliNokta.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> Düzenle</a>
        <a asp-page="Sil" asp-route-id="@Model.SeciliNokta.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
        <a asp-page="Index" class="btn btn-link"><i class="bi bi-arrow-left"></i> Listeye dön</a>
    </div>
    <div class="col-12 col-lg-7">
        <partial name="_Harita" model="new[] { Model.SeciliNokta }" />
    </div>
</div>
