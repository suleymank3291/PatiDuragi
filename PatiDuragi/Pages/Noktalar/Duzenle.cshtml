@page "{id:int}"
@model PatiDuragi.Pages.Noktalar.DuzenleModel
@{
    ViewData["Title"] = "Nokta Düzenle";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Besleme Noktaları</a></li>
        <li class="breadcrumb-item"><a asp-page="Detay" asp-route-id="@Model.Id">Detay</a></li>
        <li class="breadcrumb-item active" aria-current="page">Düzenle</li>
    </ol>
</nav>

<form method="post" class="card shadow-sm col-lg-8">
    <div class="card-header bg-success-subtle fw-semibold"><i class="bi bi-pencil-square"></i> Besleme Noktasını Düzenle</div>
    <div class="card-body">
        <partial name="_NoktaFormu" for="DuzenlenenNokta" />
    </div>
    <div class="card-footer bg-transparent">
        <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Kaydet</button>
        <a asp-page="Detay" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        konumSecici("konum-harita",
            @Json.Serialize(Model.Bolgeler.Select(b => new { b.Id, b.Mahalle, b.Ilce, b.Sinir })),
            @Json.Serialize(Model.DuzenlenenNokta.BolgeId));
    </script>
}
