@page
@model IndexModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="giris rounded-3 p-4 p-md-5 mb-4">
    <h1 class="display-6 fw-semibold"><i class="bi bi-heart-pulse text-success"></i> Pati Durağı</h1>
    <p class="lead col-lg-8">
        Mahallelerdeki sokak hayvanı besleme noktalarını tek yerde topluyoruz.
        Hangi noktanın nerede olduğunu görün, gönüllüler arasında koordinasyonu kolaylaştırın.
    </p>
    <a asp-page="/Noktalar/Index" class="btn btn-success me-2 mb-2"><i class="bi bi-geo-alt"></i> Besleme noktaları</a>
    <a asp-page="/Bolgeler/Index" class="btn btn-outline-success mb-2"><i class="bi bi-map"></i> Bölgeler</a>
</section>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-map kart-ikon text-success"></i>
                <div>
                    <div class="fs-3 fw-semibold">@Model.BolgeSayisi</div>
                    <div class="text-muted">Bölge</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-geo-alt kart-ikon text-primary"></i>
                <div>
                    <div class="fs-3 fw-semibold">@Model.Noktalar.Count</div>
                    <div class="text-muted">Besleme noktası</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-hourglass-split kart-ikon text-warning"></i>
                <div>
                    <div class="fs-3 fw-semibold">@Model.OnayBekleyenSayisi</div>
                    <div class="text-muted">Onay bekleyen nokta</div>
                </div>
            </div>
        </div>
    </div>
</div>

<h2 class="h4 mb-3">Haritada besleme noktaları</h2>
<partial name="_Harita" model="Model.Noktalar" />
