@page
@model PatiDuragi.Pages.Bolgeler.EkleModel
@{
    ViewData["Title"] = "Yeni Bölge";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Bölgeler</a></li>
        <li class="breadcrumb-item active" aria-current="page">Yeni Bölge</li>
    </ol>
</nav>

<form method="post" class="card shadow-sm col-lg-6">
    <div class="card-header bg-success-subtle fw-semibold"><i class="bi bi-plus-circle"></i> Yeni Bölge</div>
    <div class="card-body">
        <partial name="_BolgeFormu" for="YeniBolge" />
    </div>
    <div class="card-footer bg-transparent">
        <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Kaydet</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
