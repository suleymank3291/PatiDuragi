@page
@model PatiDuragi.Pages.Bolgeler.EkleModel
@{
    ViewData["Title"] = "Yeni Bölge";
}

<h1 class="h2 mb-3">Yeni Bölge</h1>

<form method="post" class="col-lg-6">
    <div class="mb-3">
        <label asp-for="YeniBolge.Ad" class="form-label"></label>
        <input asp-for="YeniBolge.Ad" class="form-control" />
        <span asp-validation-for="YeniBolge.Ad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="YeniBolge.Ilce" class="form-label"></label>
        <input asp-for="YeniBolge.Ilce" class="form-control" />
        <span asp-validation-for="YeniBolge.Ilce" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
