@model PatiDuragi.Models.Bolge

<div class="mb-3">
    <label asp-for="Ad" class="form-label"></label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-signpost-2"></i></span>
        <input asp-for="Ad" class="form-control" placeholder="Örn. Bahçelievler" />
    </div>
    <span asp-validation-for="Ad" class="text-danger small"></span>
</div>
<div class="mb-1">
    <label asp-for="Ilce" class="form-label"></label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-buildings"></i></span>
        <input asp-for="Ilce" class="form-control" placeholder="Örn. Çankaya" />
    </div>
    <span asp-validation-for="Ilce" class="text-danger small"></span>
    <div class="form-text">İlçe adında yalnızca harf kullanın.</div>
</div>
