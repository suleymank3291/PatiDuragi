@page
@model PatiDuragi.Pages.Bolgeler.IndexModel
@{
    ViewData["Title"] = "Bölgeler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Bölgeler</h1>
    <a asp-page="Ekle" class="btn btn-success"><i class="bi bi-plus-lg"></i> Yeni Bölge</a>
</div>

<div class="row g-3">
    @foreach (var bolge in Model.Bolgeler)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-map kart-ikon text-success"></i>
                    <div class="flex-grow-1">
                        <h2 class="h5 mb-0">@bolge.Ad</h2>
                        <div class="text-muted small">@bolge.Ilce</div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">@Model.NoktaSayisi(bolge.Id) nokta</span>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-page="Detay" asp-route-id="@bolge.Id" class="btn btn-sm btn-outline-success">Detay</a>
                    <a asp-page="Duzenle" asp-route-id="@bolge.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <a asp-page="Sil" asp-route-id="@bolge.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </div>
            </div>
        </div>
    }
</div>
