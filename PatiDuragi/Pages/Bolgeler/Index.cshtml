@page
@model PatiDuragi.Pages.Bolgeler.IndexModel
@{
    ViewData["Title"] = "Bölgeler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Bölgeler</h1>
    <a asp-page="Ekle" class="btn btn-success"><i class="bi bi-plus-lg"></i> Yeni Bölge</a>
</div>

@if (Model.Bolgeler.Count == 0)
{
    <div class="text-center text-muted border rounded-3 py-5">
        <i class="bi bi-map kart-ikon"></i>
        <p class="mt-2">Henüz bölge eklenmemiş.</p>
        <a asp-page="Ekle" class="btn btn-success btn-sm">İlk bölgeyi ekle</a>
    </div>
}

<div class="row g-3">
    @foreach (var bolge in Model.Bolgeler)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm kart-hover overflow-hidden">
                <div id="bolge-harita-@bolge.Id" class="bolge-harita"></div>
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-map kart-ikon text-success"></i>
                    <div class="flex-grow-1">
                        <h2 class="h5 mb-0">@bolge.Mahalle</h2>
                        <div class="text-muted small">@bolge.Ilce</div>
                    </div>
                    <span class="badge rounded-pill text-bg-light border">@bolge.Noktalar.Count nokta</span>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-page="Detay" asp-route-id="@bolge.Id" class="btn btn-sm btn-outline-success">Detay</a>
                    <a asp-page="Duzenle" asp-route-id="@bolge.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Düzenle</a>
                    <a asp-page="Sil" asp-route-id="@bolge.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        @foreach (var bolge in Model.Bolgeler)
        {
            @:bolgeHaritasiCiz("bolge-harita-@bolge.Id", @Json.Serialize(bolge.Sinir), @Json.Serialize(bolge.Noktalar.Select(n => new { n.Id, n.Ad, n.Tur, n.Enlem, n.Boylam })), true);
        }
    </script>
}
