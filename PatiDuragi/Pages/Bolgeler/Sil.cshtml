@page "{id:int}"
@model PatiDuragi.Pages.Bolgeler.SilModel
@{
    ViewData["Title"] = "Bölge Sil";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Bölgeler</a></li>
        <li class="breadcrumb-item active" aria-current="page">Sil</li>
    </ol>
</nav>

<div class="card shadow-sm col-lg-6 @(Model.Silinebilir ? "border-warning" : "border-danger")">
    <div class="card-body text-center py-4">
        @if (Model.Silinebilir)
        {
            <i class="bi bi-exclamation-triangle kart-ikon text-warning"></i>
            <p class="mt-2 mb-0">
                <strong>@Model.SeciliBolge.Ad</strong> (@Model.SeciliBolge.Ilce) bölgesi silinecek. Emin misiniz?
            </p>
        }
        else
        {
            <i class="bi bi-shield-lock kart-ikon text-danger"></i>
            <p class="mt-2 mb-0">
                <strong>@Model.SeciliBolge.Ad</strong> bölgesinde kayıtlı besleme noktaları var, bu yüzden silinemez.<br />
                Önce bu bölgedeki noktaları başka bir bölgeye taşıyın ya da silin.
            </p>
        }
    </div>
    <div class="card-footer bg-transparent text-center">
        @if (Model.Silinebilir)
        {
            <form method="post" class="d-inline">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Evet, sil</button>
            </form>
        }
        <a asp-page="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</div>
