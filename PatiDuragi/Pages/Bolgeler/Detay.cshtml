@page "{id:int}"
@model PatiDuragi.Pages.Bolgeler.DetayModel
@{
    ViewData["Title"] = "Bölge Detayı";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Bölgeler</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SeciliBolge.TamAd</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-map kart-ikon text-success"></i>
                <div class="flex-grow-1">
                    <h1 class="h3 mb-0">@Model.SeciliBolge.Mahalle</h1>
                    <div class="text-muted"><i class="bi bi-buildings"></i> @Model.SeciliBolge.Ilce</div>
                </div>
                <div class="text-center">
                    <div class="fs-3 fw-semibold">@Model.SeciliBolge.Noktalar.Count</div>
                    <div class="text-muted small">besleme noktası</div>
                </div>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var nokta in Model.SeciliBolge.Noktalar.OrderBy(n => n.Ad))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-page="/Noktalar/Detay" asp-route-id="@nokta.Id">@nokta.Ad</a>
                        <partial name="_TurRozeti" model="nokta.Tur" />
                    </li>
                }
            </ul>
            <div class="card-footer bg-transparent">
                <a asp-page="Duzenle" asp-route-id="@Model.SeciliBolge.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Düzenle</a>
                <a asp-page="Sil" asp-route-id="@Model.SeciliBolge.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
                <a asp-page="/Noktalar/Ekle" asp-route-bolgeId="@Model.SeciliBolge.Id" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Bu bölgeye nokta ekle</a>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div id="bolge-harita" class="harita rounded-3 border shadow-sm"></div>
        <div class="form-text"><span class="text-danger">Kırmızı çizgi:</span> mahallenin resmî sınırı (OpenStreetMap).</div>
    </div>
</div>

@section Scripts {
    <script>
        bolgeHaritasiCiz("bolge-harita", @Json.Serialize(Model.SeciliBolge.Sinir),
            @Json.Serialize(Model.SeciliBolge.Noktalar.Select(n => new { n.Id, n.Ad, n.Tur, n.Enlem, n.Boylam })), false);
    </script>
}
