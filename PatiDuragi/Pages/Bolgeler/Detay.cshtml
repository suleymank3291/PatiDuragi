@page "{id:int}"
@model PatiDuragi.Pages.Bolgeler.DetayModel
@{
    ViewData["Title"] = "Bölge Detayı";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="Index">Bölgeler</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SeciliBolge.Ad</li>
    </ol>
</nav>

<div class="card shadow-sm col-lg-6">
    <div class="card-body d-flex align-items-center gap-3">
        <i class="bi bi-map kart-ikon text-success"></i>
        <div class="flex-grow-1">
            <h1 class="h3 mb-0">@Model.SeciliBolge.Ad</h1>
            <div class="text-muted"><i class="bi bi-buildings"></i> @Model.SeciliBolge.Ilce</div>
        </div>
        <div class="text-center">
            <div class="fs-3 fw-semibold">@Model.NoktaSayisi</div>
            <div class="text-muted small">besleme noktası</div>
        </div>
    </div>
    <div class="card-footer bg-transparent">
        <a asp-page="Duzenle" asp-route-id="@Model.SeciliBolge.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Düzenle</a>
        <a asp-page="Sil" asp-route-id="@Model.SeciliBolge.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</a>
        <a asp-page="/Noktalar/Ekle" asp-route-bolgeId="@Model.SeciliBolge.Id" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i> Bu bölgeye nokta ekle</a>
    </div>
</div>
